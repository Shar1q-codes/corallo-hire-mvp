{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["risks"],
  "properties": {
    "risks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_statement",
          "mechanism",
          "evidence",
          "counter_signals",
          "validation_suggestion",
          "confidence",
          "confidence_rationale"
        ],
        "properties": {
          "risk_statement": {
            "type": "string",
            "minLength": 20
          },
          "mechanism": {
            "type": "string",
            "minLength": 20
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "counter_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "validation_suggestion": {
            "type": "string",
            "minLength": 20
          },
          "confidence": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "confidence_rationale": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    }
  }
}
