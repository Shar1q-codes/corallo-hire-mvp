{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["focus_areas"],
  "properties": {
    "focus_areas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_statement",
          "linked_signals",
          "why_it_matters",
          "signals_increasing_confidence",
          "signals_decreasing_confidence"
        ],
        "properties": {
          "objective_statement": {
            "type": "string",
            "minLength": 20
          },
          "linked_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 20
          },
          "signals_increasing_confidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "signals_decreasing_confidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    }
  }
}
