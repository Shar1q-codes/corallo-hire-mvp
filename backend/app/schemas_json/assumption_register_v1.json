{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assumptions"],
  "properties": {
    "assumptions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_statement",
          "assumption_type",
          "supporting_evidence",
          "counter_signals",
          "validation_target",
          "confidence",
          "confidence_rationale"
        ],
        "properties": {
          "assumption_statement": {
            "type": "string",
            "minLength": 15
          },
          "assumption_type": {
            "type": "string",
            "enum": ["JD", "Recruiter", "System"]
          },
          "supporting_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "counter_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "validation_target": {
            "type": "string",
            "minLength": 15
          },
          "confidence": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "confidence_rationale": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    }
  }
}
